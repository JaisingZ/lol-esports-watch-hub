{
  "name": "lol-esports-watch-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multilingual League of Legends Worlds 2026 video navigation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/check-content.mjs && node scripts/check-insights.mjs && node --test scripts/*.test.mjs",
    "test:data": "node --test scripts/model.test.mjs",
    "sync:official": "node scripts/sync-official.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:review": "vite build --config vite.review.config.js",
    "sync:stats": "node scripts/sync-stats.mjs",
    "import:stats": "node scripts/import-gol.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.5"
  }
}
